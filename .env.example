# RAG Chatbot Configuration
# Copy to .env and fill in values

# LLM Provider (choose one)
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Azure OpenAI (alternative)
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_ENDPOINT=your-azure-endpoint-here

# Anthropic Claude (alternative)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# xAI Grok (alternative)
# XAI_API_KEY=your-xai-key-here

# LLM Settings
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# Qdrant Settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your-qdrant-cloud-key-here  # For Qdrant Cloud

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto

# Retrieval Settings
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.7
RETRIEVAL_RERANK=true
RETRIEVAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking Settings
CHUNKING_STRATEGY=recursive
CHUNKING_CHUNK_SIZE=512
CHUNKING_CHUNK_OVERLAP=50

# Logging
LOG_LEVEL=INFO
